# Copy to .env and fill in. A .env.local next to it is loaded first and wins,
# which is how a development machine points at its own database and folders.

# MongoDB. MONGODB_URI may refer to the other variables (dotenv-expand).
MONGODB_USER=
MONGODB_PASS=
MONGODB_CLUSTER=
MONGODB_DATABASE=
MONGODB_URI=mongodb+srv://${MONGODB_USER}:${MONGODB_PASS}@${MONGODB_CLUSTER}/${MONGODB_DATABASE}

# The originals: the folder (mounted NAS share) that albums pick photos from.
# The backend only reads here.
PHOTOS_ROOT=/mnt/photos

# Where the resized variants are written and served from (/media). Must exist,
# be writable, and lie outside PHOTOS_ROOT.
VARIANTS_ROOT=/var/lib/wolfphotos/variants

# Required to browse the library and to create or edit albums. At least 16
# characters; the site asks for it once and remembers it in the browser.
ADMIN_TOKEN=

# Optional, defaults to 3002.
# PORT=3002
